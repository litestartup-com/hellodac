# Copy to .env and fill in the real values. .env is excluded by .gitignore.

# ── Session cookie signing key ──
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Admin account created on first boot ──
# Only takes effect while the database has no users at all. Leave blank and a random password is generated and printed to the log once.
MANAGER_USERNAME=admin
MANAGER_INITIAL_PASSWORD=

# ── Static key for dsh-api-gateway ──
# Must match one entry of the apiKeys array in the gateway settings inside DSH exactly.
# Also set the gateway's allowKeyProvision to false.
GW_KEY_A=
GW_KEY_B=
# Hive P0: GW_KEY_A doubles as the endpoint's sandbox_key_ref (routing by the chat's sandbox mode).

# ── Hive P2: brain internal API token ──
# Used by the brain (the skill+curl inside DSH) to call the manager's internal API; those routes only accept 127.0.0.1.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BRAIN_TOKEN=

# ── Reverse-proxy trust boundary (P0-4) ──
# X-Forwarded-For is not trusted by default: login rate limiting is keyed by client IP, and fully trusting the
# forwarding header means an attacker just switches a header to slip past the limit (the only defense against
# brute force). With the default, rate limiting counts the direct peer, so behind a reverse proxy every request
# shares one bucket -- entirely sufficient for single-user self-hosting, and impossible to forge.
# When you need the real client IP (auditing / finer-grained limiting), declare the hop you trust explicitly:
#   TRUST_PROXY=127.0.0.1          # nginx/Caddy on the same machine
#   TRUST_PROXY=172.16.0.0/12      # nginx inside the compose network
# TRUST_PROXY=

# ── Container form: host docker group GID (Debt H1) ──
# The manager container joins this GID through group_add before it can reach /var/run/docker.sock;
# scripts/gen-env.sh detects and writes it automatically, no need to fill it in by hand.
# DOCKER_GID=

# ── Backup encryption key (Debt A1, optional) ──
# Blank = the key is HKDF-derived from SESSION_SECRET (restoring needs the same .env, nothing more).
# Set = the backup key is fully separated from the session key: rotating SESSION_SECRET does not affect historical backups.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACKUP_KEY=

# ── Optional ──
# LOG_LEVEL=info
# NODE_ENV=development
