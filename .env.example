# 复制为 .env 后填写真值。.env 已被 .gitignore 排除。

# ── 会话 cookie 签名密钥 ────────────────────────────────
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── 首次启动创建的管理员账号 ────────────────────────────
# 库里没有任何用户时才生效。留空则自动生成随机密码并打印到日志一次。
MANAGER_USERNAME=admin
MANAGER_INITIAL_PASSWORD=

# ── dsh-api-gateway 的静态密钥 ──────────────────────────
# 必须与 DSH 里 gateway 设置的 apiKeys 数组中的某一项完全一致。
# 同时把 gateway 的 allowKeyProvision 设为 false。
GW_KEY_A=
GW_KEY_B=
# 蜂群 P0：GW_KEY_A 同时用于 endpoint 的 sandbox_key_ref（按会话沙箱模式路由）。

# ── 蜂群 P2：主脑内部 API 令牌 ────────────────────────
# 主脑（DSH 里的 skill+curl）调 manager 内部 API 用；路由只接受 127.0.0.1。
# 生成：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BRAIN_TOKEN=

# ── 反代信任边界（P0-4）────────────────────────────────
# 默认不信任 X-Forwarded-For：登录限流以客户端 IP 为键，全信任转发头等于
# 攻击者换个头就绕过限流（暴破的唯一防线）。默认值下限流按直连对端计数，
# 反代之后所有请求共用一个计数桶——单用户自托管完全够用，且不可伪造。
# 需要真实客户端 IP（审计/限流更精细）时，显式声明可信的那一跳：
#   TRUST_PROXY=127.0.0.1          # 同机 nginx/Caddy
#   TRUST_PROXY=172.16.0.0/12      # compose 内网里的 nginx
# TRUST_PROXY=

# ── 容器形态：宿主 docker 组 GID（债务 H1）────────────────
# manager 容器经 group_add 加入该 GID 才能访问 /var/run/docker.sock；
# 由 scripts/gen-env.sh 自动探测写入，无需手填。
# DOCKER_GID=

# ── 备份加密密钥（债务 A1，可选）─────────────────────────
# 留空 = 密钥 HKDF 派生自 SESSION_SECRET（同 .env 前提即可恢复）。
# 设置 = 备份密钥与会话密钥彻底分离：轮换 SESSION_SECRET 不影响历史备份。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACKUP_KEY=

# ── 可选 ────────────────────────────────────────────────
# LOG_LEVEL=info
# NODE_ENV=development
