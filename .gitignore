node_modules/
dist/
*.tsbuildinfo

# Config backups are derived artifacts, never committed
manager.config.backup.yaml

# Secrets and local config: never committed
.env
.env.local
# Personal config (real paths); for the public template see manager.config.example.yaml
manager.config.yaml

# Runtime data (SQLite database, logs)
data/
*.db
*.db-wal
*.db-shm
logs/
*.log

# Release build directory
dist-release/

# Each agent's workspace is managed by its own git repository, not committed to the manager repo
workspaces/

# Docs: the public surface is only README.md / docs/USER-GUIDE.md / CHANGELOG.md / LICENSE.
# Internal working documents (design/plan/roadmap/review/release process) live in a separate internal
# design repository and are not committed here.
# Local development rules and context (read first every session) also stay on this machine only:
RULE.md
CONTEXT.md
notes/
docs/MILESTONES.md
docs/RELEASE.md
docs/TECH-*.md
docs/archive/

# The repo-root AGENTS.md = this machine's agent development discipline (internal wording: it names design-repo
# paths and local habits) and belongs to the "local rules" category, so it is not committed to the public repo
# (decided by the user on 2026-09-24). External discipline lives in CONTRIBUTING.md.
# **Must be anchored to the root directory**: templates/{brain,company,personal,product}/AGENTS.md are templates
# to be seeded with the workspace, and those must stay in git -- they must not be swept up by this rule.
/AGENTS.md

# PowerShell 5.1 ModuleAnalysisCache (produced when running PS5.1 scripts in this directory)
Microsoft/

# nginx runtime config = a derived artifact generated by install.sh (the truth source is *.conf.example and the tls-*.conf templates)
deploy/nginx/default.conf

# upgrade/rollback backups (upgrade-node-version.mjs writes them NEXT TO the truth files with a
# .pre-<target>.bak suffix -- the .env copy contains secrets, never commit any of them; the old
# specific pre-012/pre-mig patterns are subsumed by this one)
*.pre-*.bak

# M1 pilot leftovers (workspace + generated artifacts, never committed)
.m1-pilot/

# Per-machine launcher = a derived artifact `npm run service install` generates from local paths (see src/cli/service.ts
# windowsLauncher), never committed. The old-named copy is a leftover from before the 2026-09-24 rename, kept only on the
# production machine for the scheduled task OhdshManager until cutover, and deleted once the switch is complete.
scripts/dac-start.cmd
scripts/ohdsh-start.cmd
