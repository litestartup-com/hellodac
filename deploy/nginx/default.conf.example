# nginx default-form template (plain HTTP, no domain / no TLS).
# This is a template, not the runtime config: the runtime file deploy/nginx/default.conf is generated by
# install.sh (no domain -> copy this file; with a domain -> sed the tls-*.conf templates), and it is
# excluded by .gitignore -- re-running install.sh on a live host rewrites it, so it must never enter git
# (otherwise git pull always reports modified, a pit hit for real on 2026-09-07).
# Manual use (skipping install.sh): cp deploy/nginx/default.conf.example deploy/nginx/default.conf
server {
    listen 80;
    server_name _;

    client_max_body_size 20m;

    location / {
        proxy_pass http://manager:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE and mux long-lived connections
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Debt H1: the brain internal API only admits the private network. Brain nodes reach the manager directly over the
    # manager:8080 internal network and do not come through here; this is the second gate beyond the token -- public
    # requests (including those proxied by Cloudflare) are always 403.
    location /api/internal/ {
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
        proxy_pass http://manager:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
    }
}
